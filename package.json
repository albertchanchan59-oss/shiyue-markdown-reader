{
  "name": "shiyue-markdown-reader",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4399 --strictPort",
    "build": "vite build && node scripts/package.mjs",
    "start": "node server.mjs --open",
    "test": "node --test tests/*.test.js",
    "desktop": "npm run build && install-electron && electron .",
    "mac:build": "./scripts/build-macos.sh",
    "mac:dmg": "./scripts/package-dmg.sh",
    "mac:run": "./script/build_and_run.sh"
  },
  "dependencies": {
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0"
  },
  "main": "desktop/main.cjs",
  "description": "拾页 Markdown 阅读器：高亮、下划线与批注",
  "author": "拾页",
  "license": "MIT"
}
